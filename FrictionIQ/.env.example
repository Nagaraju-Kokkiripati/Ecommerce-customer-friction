# Development defaults. Copy this file to .env and edit locally.
ENV=development
DEBUG=false
ADMIN_USERNAME=admin
# Required outside development. Generate a salted hash using the README command.
ADMIN_PASSWORD_HASH=
# Required outside development: a random key of at least 32 characters.
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_256BIT_KEY
ABANDONMENT_MINUTES=30
EMAIL_MODE=simulated
# To send approved emails: EMAIL_MODE=smtp, then configure these fields.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Configure these to your actual HTTPS site origin when deployed.
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
